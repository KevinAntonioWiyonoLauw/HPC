# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# --- LLM provider (OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:12800/v1
LLM_API_KEY=isi-api-key-anda
LLM_MODEL=tokenharbor/qwen3.8-flash
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=512

# --- Embedding ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DEVICE=cpu

# --- Service ---
API_HOST=127.0.0.1
API_PORT=8000
DATA_DIR=./data
